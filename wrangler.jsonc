// Cloudflare settings for the songs site and the MP fan page.
// The site is plain files; worker.js only answers /api/* (comments, updates, email sign-ups).
{
  "name": "mclearn-songs",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },
  // Fan wall storage. No ID needed: on deploy, Wrangler 4.45+ creates the
  // namespace and links it to this Worker automatically.
  "kv_namespaces": [ { "binding": "FANS" } ],
  "observability": { "enabled": true }
}
