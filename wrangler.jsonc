// Cloudflare settings for the songs site and the MP fan page.
// The site is plain files; worker.js only answers /api/* (comments, updates, email sign-ups).
{
  "name": "mclearn-songs",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/new", "/new/", "/tiktok", "/tiktok/", "/mp", "/mp/"],
    "html_handling": "auto-trailing-slash"
  },
  // Fan wall storage: comments, news and email sign-ups (namespace "mclearn-songs-fans").
  // Pinned by ID so the data stays the same whatever the Worker is named.
  "kv_namespaces": [ { "binding": "FANS", "id": "dc0dcf21303340e28ea00105281ddffb" } ],
  "observability": { "enabled": true }
}
